<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared course links (AppLinkService). Which /<org>/course/ paths open
	     this app is decided by /.well-known/apple-app-site-association on
	     the host, keyed by <TeamID>.<bundle id>. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:course-share.web.app</string>
	</array>
</dict>
</plist>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="NEXORA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FCM: route incoming pushes through the same channel id created by
             LocalNotificationService so foreground + background banners share
             one channel + sound + importance setting. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="crinza_default" />
        <!-- FCM: monochrome icon for the status-bar tray (Android 5+). Falls
             back to the launcher icon if absent. We point at the launcher
             until a dedicated white-on-transparent asset is added. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- audio_service: background media playback for live-class audio
             (keeps audio alive when the app is backgrounded / screen off,
             with lock-screen + notification controls). -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Android 13+ runtime notification permission. firebase_messaging asks
         for it via requestPermission(); the manifest entry is still required
         for the prompt to surface. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live-class real-time audio (raise-hand → speak). RECORD_AUDIO is
         requested at runtime only when a student is about to speak.
         INTERNET is needed for the WebRTC/LiveKit audio connection.
         No camera permission — students never publish video. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- audio_service background playback (live-class audio in background). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Play infers REQUIRED hardware from permissions and from library
         manifests, silently excluding devices that lack it. None of this
         hardware is actually required:
           * microphone — implied by RECORD_AUDIO. Only raise-hand-to-speak
             in a live class needs a mic, requested at runtime; the app is
             fully usable without one.
           * nfc / telephony — implied by permissions Razorpay's AARs inject
             (NFC, READ_BASIC_PHONE_STATE). Card payments need neither, and
             without these lines Wi-Fi-only tablets and non-NFC phones are
             filtered off the listing. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ (API 30) package visibility: without this,
             canLaunchUrl()/launchUrl() for https:// links (Rate our App,
             T&C, Refund Policy, WhatsApp support) can silently report no
             app can handle the intent even though the Play Store / a
             browser is installed. See
             https://developer.android.com/training/package-visibility -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <package android:name="com.android.vending"/>
    </queries>
</manifest>
